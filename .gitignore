node_modules
/dist
.DS_Store
src-tauri/target
.snapshots

# Deploy credentials for scripts/redeploy.mjs.
.env
.env.*

# The server's own build output and its runtime state - the SQLite index, the
# extracted cover-art cache, in-flight uploads, and any music kept locally
# while testing.
server/target
server/data
server/music

# Generated mobile projects. `tauri ios init` / `android init` rebuild these,
# with one exception noted in src-tauri/gen/apple/project.yml: the iOS
# deployment target is hand-set there, so that file IS tracked.
src-tauri/gen/apple/build
src-tauri/gen/apple/Externals
src-tauri/gen/apple/app.xcodeproj
src-tauri/gen/apple/Pods
src-tauri/gen/apple/Podfile.lock
# The generated Android project is disposable - EXCEPT the hand-written
# native layer, which `tauri android init` would replace with the stock
# template and never recreate: the Android Auto media service, the JS
# bridge (now-playing, artwork, transport), the manifest's intent filters
# and Auto declarations, and the orientation locks. Those stay tracked;
# everything generated around them stays ignored. (`dir/**` not `dir/`,
# because git refuses to re-include below an excluded DIRECTORY - the
# negation chain below only works when the exclusion is on contents.)
src-tauri/gen/android/**
!src-tauri/gen/android/app/
!src-tauri/gen/android/app/src/
!src-tauri/gen/android/app/src/main/
!src-tauri/gen/android/app/src/main/AndroidManifest.xml
!src-tauri/gen/android/app/src/main/java/
!src-tauri/gen/android/app/src/main/java/com/
!src-tauri/gen/android/app/src/main/java/com/mattssoftware/
!src-tauri/gen/android/app/src/main/java/com/mattssoftware/attackfm/
!src-tauri/gen/android/app/src/main/java/com/mattssoftware/attackfm/**
src-tauri/gen/android/app/src/main/java/com/mattssoftware/attackfm/generated/
!src-tauri/gen/android/app/src/main/res/
!src-tauri/gen/android/app/src/main/res/values/
!src-tauri/gen/android/app/src/main/res/values/**
!src-tauri/gen/android/app/src/main/res/values-sw600dp/
!src-tauri/gen/android/app/src/main/res/values-sw600dp/**
!src-tauri/gen/android/app/src/main/res/xml/
!src-tauri/gen/android/app/src/main/res/xml/**
# The widget's hand-written resources. Named FILES, not the whole dirs: the
# launcher-icon mipmaps and any future generated drawables stay untracked,
# and a new hand-written resource has to be added here on purpose - which is
# exactly the check that caught these two nearly vanishing.
!src-tauri/gen/android/app/src/main/res/layout/
!src-tauri/gen/android/app/src/main/res/layout/widget_now_playing.xml
!src-tauri/gen/android/app/src/main/res/layout/widget_now_playing_medium.xml
!src-tauri/gen/android/app/src/main/res/layout/widget_now_playing_large.xml
!src-tauri/gen/android/app/src/main/res/layout/widget_shot_compact.xml
!src-tauri/gen/android/app/src/main/res/layout/widget_shot_medium.xml
!src-tauri/gen/android/app/src/main/res/layout/widget_shot_large.xml
!src-tauri/gen/android/app/src/main/res/drawable/
!src-tauri/gen/android/app/src/main/res/drawable/widget_bg.xml
!src-tauri/gen/android/app/src/main/res/drawable/widget_art_placeholder.xml
!src-tauri/gen/android/app/src/main/res/drawable/widget_play_preview.xml
!src-tauri/gen/android/app/src/main/res/drawable/ic_widget_prev.xml
!src-tauri/gen/android/app/src/main/res/drawable/ic_widget_next.xml
!src-tauri/gen/android/app/src/main/res/drawable/ic_widget_heart.xml
!src-tauri/gen/android/app/src/main/res/drawable/ic_widget_heart_on.xml
# The app's build script is no longer purely generated: it carries the release
# signingConfigs that make a Play-acceptable bundle. Untracked, that wiring
# lived on one Mac's disk and a fresh clone silently produced unsigned
# releases again. The secrets it READS stay out - keystore.properties is
# ignored above and the .jks lives outside the repo entirely.
!src-tauri/gen/android/app/build.gradle.kts

# Song data never belongs in this repo. The library lives in the OS music
# folder or on the streaming server; the one time audio appeared here it was
# the importer bug that turned a server URL into a literal "https:/host/"
# directory of downloads. Belt (the extensions) and suspenders (the dir).
*.m4a
*.m4b
*.mp3
*.flac
*.wav
*.aiff
*.aif
*.ogg
*.oga
*.opus
*.wma
*.ape
*.wv
https:*/
dist-home/
# Python evaluation artifacts
__pycache__/
*.py[cod]
# The server's runtime database lives here in local dev; it is a
# listener's data, never the repo's.
data/
dist-site/

# Screenshot-capture seed: holds a live session + stream token, must stay
# untracked AND ignored - it once sat untracked-but-not-ignored in this shared
# tree, one `git add -A` away from a public repo.
public/__seed.json
capture/
