{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AttackFM",
  "version": "0.3.15",
  "identifier": "com.mattssoftware.attackfm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5240",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AttackFM",
        "width": 680,
        "height": 680,
        "minWidth": 560,
        "minHeight": 560,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "resizable": true,
        "maximizable": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$AUDIO/**",
          "$HOME/**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "attackfm"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "iOS": {
      "minimumSystemVersion": "15.0",
      "developmentTeam": "F6ZAL7ANAD"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
