<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Simulator-only entitlements: the base file plus CarPlay.

  com.apple.developer.carplay-audio is granted by Apple per-app, on
  application (https://developer.apple.com/carplay/ -> request the audio
  entitlement for com.mattssoftware.attackfm). Until that grant exists, a
  DEVICE build carrying this key fails to sign against any provisioning
  profile - so the device entitlements (app_iOS.entitlements) leave it out
  and the CarPlay code sits dormant on the phone, while the simulator, which
  does not check provisioning, carries it and can drive the whole CarPlay UI
  today. Once Apple grants it, move the key into app_iOS.entitlements and
  both builds light up.

  Wired via CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*] in project.yml.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.carplay-audio</key>
	<true/>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:attack.fm</string>
		<string>applinks:registry.attack.fm</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.mattssoftware.attackfm</string>
	</array>
</dict>
</plist>
