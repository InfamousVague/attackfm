<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.4.1</string>
	<key>CFBundleVersion</key>
	<string>0.4.1</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.music</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_attackfm-jam._tcp</string>
		<string>_attackfm-jam._udp</string>
	</array>
	<!-- Location exists for one number: your speed, for the "louder when
	     driving" volume rise. Watched only while that setting is on, never
	     stored, never sent anywhere - the maths happens on the phone. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>AttackFM uses your speed only to raise the volume against road noise when “Louder when driving” is on.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>AttackFM uses the microphone only when you press the DJ’s talk button, to hear what music you ask for.</string>
	<key>NSCameraUsageDescription</key>
	<string>AttackFM uses the camera only to scan QR codes: signing in from another device you own, and adding a friend from their code.</string>
	<!-- Picking your profile picture and banner, and a cover for a playlist.
	     Read-only and only when you tap to choose one: nothing is ever written
	     back to your library, which is why there is no Add usage key here. On
	     iOS 14+ the web view's file input uses the out-of-process picker and
	     would often work without this - but "often" is not a contract, and an
	     app that touches the photo library without declaring why is one App
	     Review can reject. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>AttackFM opens your photo library only when you choose a profile picture, a banner, or a playlist cover.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>AttackFM connects to your music server on this network.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>TaoSceneDelegate</string>
				</dict>
			</array>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>CarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>AFMCarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.mattssoftware.attackfm</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>attackfm</string>
			</array>
		</dict>
	</array>
</dict>
</plist>