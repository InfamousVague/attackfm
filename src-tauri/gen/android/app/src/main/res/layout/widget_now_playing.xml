<?xml version="1.0" encoding="utf-8"?>
<!-- THE COMPACT FACE: one row, four cells wide, the height of a notification.

     Every face carries the same view ids, so one binder in the provider fills
     whichever one the launcher asked for and nothing branches on size except
     the choice of layout itself. What a face LEAVES OUT is the only difference
     between them: this one has no clocks and no heart, because a row this
     short would have to shrink the words to fit them, and the words are the
     thing you are actually reading.

     The scrubber survives even here, as a hairline under the row - it is the
     one thing a media widget can say that a notification cannot. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_bg"
  android:orientation="vertical"
  android:paddingStart="14dp"
  android:paddingEnd="10dp"
  android:paddingTop="12dp"
  android:paddingBottom="12dp">

  <LinearLayout
    android:id="@+id/widget_transport"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:id="@+id/widget_art"
      android:layout_width="46dp"
      android:layout_height="46dp"
      android:contentDescription="@null"
      android:scaleType="fitXY"
      android:src="@drawable/widget_art_placeholder" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_marginEnd="6dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/widget_title"
        android:text="AttackFM"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/widget_artist"
        android:text="Nothing playing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#A6FFFFFF"
        android:textSize="12sp" />

      <TextView
        android:id="@+id/widget_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#8AFFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />
    </LinearLayout>

    <ImageView
      android:id="@+id/widget_prev"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:contentDescription="Previous"
      android:padding="7dp"
      android:scaleType="fitCenter"
      android:src="@drawable/ic_widget_prev" />

    <ImageView
      android:id="@+id/widget_play"
      android:layout_width="42dp"
      android:layout_height="42dp"
      android:layout_marginStart="2dp"
      android:layout_marginEnd="2dp"
      android:contentDescription="Play or pause"
      android:scaleType="fitCenter"
      android:src="@drawable/widget_play_preview" />

    <ImageView
      android:id="@+id/widget_next"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:contentDescription="Next"
      android:padding="7dp"
      android:scaleType="fitCenter"
      android:src="@drawable/ic_widget_next" />

    <ImageView
      android:id="@+id/widget_heart"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:contentDescription="Favourite"
      android:visibility="gone" />
  </LinearLayout>

  <ImageView
    android:id="@+id/widget_wave"
    android:layout_width="match_parent"
    android:layout_height="7dp"
    android:layout_marginTop="8dp"
    android:contentDescription="@null"
    android:scaleType="fitXY" />

  <LinearLayout
    android:id="@+id/widget_clocks"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:visibility="gone">

    <TextView
      android:id="@+id/widget_elapsed"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:textColor="#8AFFFFFF"
      android:textSize="11sp" />

    <TextView
      android:id="@+id/widget_remaining"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="#8AFFFFFF"
      android:textSize="11sp" />
  </LinearLayout>
</LinearLayout>
