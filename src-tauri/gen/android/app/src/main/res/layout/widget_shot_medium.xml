<?xml version="1.0" encoding="utf-8"?>
<!-- See widget_shot_compact.xml for what this file is and what it must agree
     with. Medium: the heart rides the top row's trailing edge, and the
     transport is a centred row across the bottom ~28%. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/widget_shot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="Now playing"
    android:scaleType="fitXY" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="34"
      android:orientation="horizontal">

      <View
        android:id="@+id/widget_open"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="82" />

      <View
        android:id="@+id/widget_heart"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="18"
        android:contentDescription="Favourite" />
    </LinearLayout>

    <!-- The scrubber and its clocks. -->
    <View
      android:id="@+id/widget_open_bottom"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="30" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="36"
      android:orientation="horizontal">

      <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="30" />

      <View
        android:id="@+id/widget_prev"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="13"
        android:contentDescription="Previous" />

      <View
        android:id="@+id/widget_play"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="14"
        android:contentDescription="Play or pause" />

      <View
        android:id="@+id/widget_next"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="13"
        android:contentDescription="Next" />

      <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="30" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
