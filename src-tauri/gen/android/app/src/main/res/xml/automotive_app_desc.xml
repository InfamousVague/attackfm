<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android Auto reads to decide this app is worth showing.

  Without this file and the meta-data that points at it, the car never asks the
  MediaBrowserService anything, however good the MediaSession is - which is why
  a working session still showed nothing on the dashboard.
-->
<automotiveApp>
    <uses name="media" />
</automotiveApp>
