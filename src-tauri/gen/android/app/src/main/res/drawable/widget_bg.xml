<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's plate: the app's own near-black, rounded like the nav island,
     with the hairline the Now Playing surfaces wear.

     A solid colour rather than a theme attribute because RemoteViews render in
     the LAUNCHER's process, where the app's theme does not exist. The provider
     tints this at runtime from the cover, the way the Now Playing backdrop
     does - this file is the shape and the fallback. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <solid android:color="#F2101014" />
  <corners android:radius="28dp" />
  <stroke android:width="1dp" android:color="#1AFFFFFF" />
</shape>
