<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Background playback. Without these the app is, to Android, an ordinary
         app that happens to make noise: backgrounded behind navigation it gets
         frozen or killed the moment memory is wanted elsewhere. See
         PlaybackService. POST_NOTIFICATIONS is what lets the ongoing notice
         show on Android 13+; the service still runs if it is refused. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- One sentence at a time: the Booth's talk-to-the-DJ button. The WebView
         asks per-site on top of this, so the install-time grant alone records
         nothing. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Speed only, for the louder-when-driving volume rise. The WebChromeClient
         already fields the WebView's geolocation prompt; these are the manifest
         halves its runtime request needs to exist. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.app"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- Tells Android Auto this app is a media app; points at res/xml. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- What stands the Cast framework up: CastContext reads this class
             for its options (receiver id). Without it getSharedInstance
             throws, which CastBridge reads as "this device cannot cast". -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.mattssoftware.attackfm.CastOptionsProvider" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!--
              "Play Fleetwood Mac on AttackFM."

              The session's own onPlayFromSearch only reaches an app that is
              ALREADY the active media app - which, said to a phone in a
              pocket, it is not. Assistant reaches a cold app through this
              intent instead, and without the filter the request goes to
              whichever app does have it. This is the difference between the
              app being askable and merely being controllable.
            -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!--
              Spotify's own URI scheme, declared by hand because the deep-link
              plugin's config only generates host-based App Links.

              This is the door that actually produces the chooser. An https
              link to open.spotify.com is a VERIFIED App Link that Spotify
              owns, and on Android 12+ a verified link goes straight to its
              verified app - a second app declaring the same host is not
              offered at all, which is the entire point of verification. A
              custom scheme cannot be verified by anyone, so declaring it here
              puts AttackFM beside Spotify in a real "open with" dialog.

              The generated block above still declares open.spotify.com, and
              that becomes reachable the moment someone turns off "Open
              supported links" for Spotify in Android's app settings. Harmless
              until then.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="spotify" />
            </intent-filter>

            <!--
              The share sheet, which is the door that actually works.

              Tapping an https://open.spotify.com link can never reach us while
              Spotify is installed: Spotify has VERIFIED that domain, and a
              verified App Link goes to its owner without a chooser. The
              spotify: scheme above does reach a chooser, but almost nothing
              hands out links in that form.

              Sharing asks the user every time, needs nothing turned off, and
              Spotify's own Share menu lists whatever declares this. text/plain
              because that is what every app shares a link as.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
            <intent-filter android:autoVerify="true" >
                <action android:name="android.intent.action.VIEW" />
                <!-- ChromeOS ARC++ uses a different action for deep links -->
                <action android:name="org.chromium.arc.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="open.spotify.com" />
                
                
                <data android:pathPrefix="/track" />
                <data android:pathPrefix="/album" />
                <data android:pathPrefix="/artist" />
                <data android:pathPrefix="/playlist" />
                
            </intent-filter>
            <intent-filter android:autoVerify="true" >
                <action android:name="android.intent.action.VIEW" />
                <!-- ChromeOS ARC++ uses a different action for deep links -->
                <action android:name="org.chromium.arc.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="registry.attack.fm" />
                
                
                <data android:pathPrefix="/i" />
                
            </intent-filter>
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
        </activity>

        <!--
          Exported WITH the browser action: this is the door Android Auto knocks
          on. A media session alone is invisible to the car - it only looks at
          apps that answer android.media.browse.MediaBrowserService.
        -->
        <!-- Now playing on the home screen. Exported because the LAUNCHER is
             what sends APPWIDGET_UPDATE - an unexported receiver draws once at
             placement and then never hears from the system again. -->
        <receiver
            android:name=".NowPlayingWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_playing_info" />
        </receiver>

        <service
            android:name=".PlaybackService"
            android:foregroundServiceType="mediaPlayback|dataSync"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
