<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the generated iOS Info.plist by the Tauri build.

  UIBackgroundModes is the entitlement half of background playback; the other
  half is claiming the AVAudioSession category, which src/ios_audio.rs does at
  launch. Neither works without the other: the plist without the session gets a
  process that is allowed to play in the background but whose audio still stops
  at the lock screen, and the session without the plist gets suspended outright.

  NSAppTransportSecurity allows a plain-HTTP server on the local network, which
  is the normal case for a music server running on a box at home. Anything on
  the public internet should still be HTTPS, and the client defaults a typed
  bare hostname to https:// for exactly that reason - this only stops iOS from
  refusing a deliberate http:// address on a LAN.
-->
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- The custom URL scheme invite links open the app through:
	     registry.attack.fm/i/<code>'s "Open in AttackFM" button points at
	     attackfm://i/<code>, and JoinServer reads the code off it. This MUST
	     live here, not in gen/apple/app_iOS/Info.plist: `tauri ios build`
	     regenerates that file and drops manual keys, so a scheme added there
	     silently never ships (which is exactly why the button used to do
	     nothing). This merge file survives, so the scheme is always in the
	     built app. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.mattssoftware.attackfm</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>attackfm</string>
			</array>
		</dict>
	</array>

	<!-- iOS 26+ TRAPS any app that never adopted the scene lifecycle
	     (EXC_BREAKPOINT in __UIApplicationEvaluateRuntimeIssueForNoScene-
	     LifecycleAdoption) - fatal on the iOS 27 runtime, a warning on 26,
	     which is why the app ran on a 26.4.1 simulator and died at launch on
	     27.0 before drawing a frame.

	     SupportsMultipleScenes=true is the load-bearing key: tao 0.35.3 keys
	     everything scene-shaped off multiple_scenes_enabled() - it registers
	     application:configurationForConnectingSceneSession: on its app
	     delegate (so UIKit gets a config naming TaoSceneDelegate from CODE,
	     and this manifest's UISceneConfigurations block is only the fallback
	     UIKit would consult without that method) and defers
	     did_finish_launching to the first scene connect inside
	     TaoSceneDelegate. Keep the UISceneConfigurations block anyway: it is
	     the documented fallback, and harmless while the delegate method wins.

	     That delegate method is also why release builds crashed at launch on
	     iOS 27 devices while debug ran fine: stock tao 0.35.3 returned the
	     UISceneConfiguration without transferring ownership, so optimized
	     builds freed it before UIKit read it (SIGSEGV objc_retain in
	     _connectUISceneFromFBSScene). src-tauri/vendor/tao carries the
	     one-line 0.36.0 backport; see [patch.crates-io] in Cargo.toml. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>TaoSceneDelegate</string>
				</dict>
			</array>
			<!-- The CarPlay scene, independent of the phone scene above: UIKit
			     instantiates AFMCarPlaySceneDelegate (gen/apple/Sources/app/
			     carplay.m) when a car connects, and tao never hears about it.
			     Dormant without the carplay-audio entitlement, which simulator
			     builds carry and device builds gain once Apple grants it. -->
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>CarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>AFMCarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>

	<!-- Portrait only. The player is a one-hand surface; landscape gave a
	     stretched bar and lyric bands built for a shape the design never
	     meant to serve. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Asks once, on first use, so a server advertised over mDNS on the home
	     network can be reached at all. iOS 14+ refuses local connections
	     silently without it. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>AttackFM connects to your music server on this network.</string>

	<!-- Multipeer's own Bonjour types, both halves of the pair. iOS 14+ will
	     not browse a service that is not declared here - it fails silently,
	     which is the worst way to learn this - and MultipeerConnectivity
	     registers TCP and UDP for one service type. Must match the string in
	     Sources/app/nearby.swift. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_attackfm-jam._tcp</string>
		<string>_attackfm-jam._udp</string>
	</array>

	<!-- Export compliance: the app's only cryptography is standard HTTPS/TLS to
	     the music server, which is exempt. Declaring it here means TestFlight
	     and App Store Connect stop asking the compliance question on every
	     upload. Set to <true/> and add ITSEncryptionExportComplianceCode if a
	     future feature adds non-exempt (custom/proprietary) encryption. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- The App Store category the listing files under. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.music</string>

	<!-- Why the app may open the camera: reading the "link a device" QR shown
	     by another signed-in device. The camera is never used otherwise, and
	     the sign-in screen falls back to a typed code where it is unavailable. -->
	<!-- The microphone exists for one sentence at a time: the Booth's
	     "tell the DJ" button records a short clip and sends it to your own
	     server, which turns it into text there. Nothing records unless that
	     button is held, and the clip goes only to the server you signed into. -->
	<!-- Location exists for one number: your speed, for the "louder when
	     driving" volume rise. Watched only while that setting is on, never
	     stored, never sent anywhere - the maths happens on the phone. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>AttackFM uses your speed only to raise the volume against road noise when “Louder when driving” is on.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>AttackFM uses the microphone only when you press the DJ’s talk button, to hear what music you ask for.</string>
	<key>NSCameraUsageDescription</key>
	<string>AttackFM uses the camera only to scan QR codes: signing in from another device you own, and adding a friend from their code.</string>
</dict>
</plist>
