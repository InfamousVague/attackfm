<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the generated iOS Info.plist by the Tauri build.

  UIBackgroundModes is the entitlement half of background playback; the other
  half is claiming the AVAudioSession category, which src/ios_audio.rs does at
  launch. Neither works without the other: the plist without the session gets a
  process that is allowed to play in the background but whose audio still stops
  at the lock screen, and the session without the plist gets suspended outright.

  NSAppTransportSecurity allows a plain-HTTP server on the local network, which
  is the normal case for a music server running on a box at home. Anything on
  the public internet should still be HTTPS, and the client defaults a typed
  bare hostname to https:// for exactly that reason - this only stops iOS from
  refusing a deliberate http:// address on a LAN.
-->
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- iOS 26+ TRAPS any app that never adopted the scene lifecycle
	     (EXC_BREAKPOINT in __UIApplicationEvaluateRuntimeIssueForNoScene-
	     LifecycleAdoption) - fatal on the iOS 27 runtime, a warning on 26,
	     which is why the app ran on a 26.4.1 simulator and died at launch on
	     27.0 before drawing a frame.

	     Every field is load-bearing, exactly as PrettyCardboard's project.yml
	     documents the same fix: tao does NOT implement
	     application:configurationForConnectingSceneSession:, so the delegate
	     class must be named HERE or UIKit connects the scene with nothing and
	     segfaults in _connectUISceneFromFBSScene. And tao gates on
	     SupportsMultipleScenes: when true it defers did_finish_launching to
	     the first scene setup, which only ever runs inside TaoSceneDelegate
	     (verified present in tao 0.35.3). The two settings are a pair. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>TaoSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>

	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Asks once, on first use, so a server advertised over mDNS on the home
	     network can be reached at all. iOS 14+ refuses local connections
	     silently without it. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>AttackFM connects to your music server on this network.</string>
</dict>
</plist>
