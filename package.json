{
  "name": "attackfm",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test && npm run prefs:check && npm run i18n:gate",
    "i18n:scan": "node scripts/i18n-scan.mjs",
    "i18n:check": "node scripts/i18n-scan.mjs --catalogues",
    "i18n:verify": "node scripts/i18n-verify.mjs",
    "i18n:gate": "node scripts/i18n-scan.mjs --max 0 && node scripts/i18n-scan.mjs --keys && node scripts/i18n-scan.mjs --catalogues && node scripts/i18n-verify.mjs --quiet",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "ios:dev": "node scripts/ios-clean.mjs && tauri ios dev",
    "ios:build": "node scripts/ios-clean.mjs && tauri ios build",
    "ios:build:sim": "node scripts/ios-clean.mjs && tauri ios build --debug --target aarch64-sim",
    "android:dev": "JAVA_HOME=\"/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home\" ANDROID_HOME=\"$HOME/Library/Android/sdk\" NDK_HOME=\"$HOME/Library/Android/sdk/ndk/26.3.11579264\" tauri android dev",
    "android:build": "JAVA_HOME=\"/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home\" ANDROID_HOME=\"$HOME/Library/Android/sdk\" NDK_HOME=\"$HOME/Library/Android/sdk/ndk/26.3.11579264\" tauri android build",
    "android:build:staging": "ORG_GRADLE_PROJECT_afmStaging=true JAVA_HOME=\"/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home\" ANDROID_HOME=\"$HOME/Library/Android/sdk\" NDK_HOME=\"$HOME/Library/Android/sdk/ndk/26.3.11579264\" tauri android build --apk",
    "server": "cargo run --manifest-path server/Cargo.toml",
    "redeploy": "node scripts/redeploy.mjs",
    "redeploy:setup": "node scripts/redeploy.mjs setup",
    "redeploy:registry": "node scripts/deploy-registry.mjs",
    "bundle:home": "node scripts/home-bundle.mjs",
    "android:emulator": "\"$HOME/Library/Android/sdk/emulator/emulator\" -avd attackfm -netdelay none -netspeed full",
    "ship": "node scripts/ship-update.mjs",
    "site:dev": "vite --config vite.site.config.ts",
    "site:build": "npm run demo:fixtures && vite build --config vite.site.config.ts && npm run demo:build",
    "site:preview": "vite preview --config vite.site.config.ts",
    "site:deploy": "node scripts/deploy-site.mjs",
    "listen:deploy": "node scripts/deploy-listen.mjs",
    "listen:build": "AFM_WEB=1 vite build",
    "filters:check": "node scripts/check-filters.mjs",
    "prefs:check": "node scripts/check-prefs.mjs",
    "check:styles": "node scripts/check-style-guard.mjs",
    "demo:fixtures": "node scripts/make-demo-fixtures.mjs",
    "demo:build": "vite build --config vite.demo.config.ts",
    "build:landing": "node scripts/landing-borrow.mjs && vite build --config vite.landing.config.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "e2e": "playwright test --project=fast",
    "e2e:slow": "playwright test --project=slow --pass-with-no-tests",
    "e2e:typecheck": "tsc -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@glacier/icons": "file:./vendor/@glacier/icons",
    "@glacier/react": "file:./vendor/@glacier/react",
    "@glacier/tokens": "file:./vendor/@glacier/tokens",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-haptics": "^2.3.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "i18next": "^26.4.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.23.0",
    "music-metadata": "^11.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-easy-crop": "^6.2.3",
    "react-i18next": "^17.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
