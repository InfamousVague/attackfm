# AttackFM music server - systemd unit.
#
# Install:
#   install -d -o attackfm -g attackfm /opt/attackfm/{bin,data,music}
#   cp attackfm.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now attackfm
#
# The whole configuration is the Environment lines below; there is no config
# file to keep in sync with them.

[Unit]
Description=AttackFM music server
After=network-online.target
Wants=network-online.target

[Service]
# Loopback only: Caddy terminates TLS and is the only thing that may reach this.
Environment=AFM_BIND=127.0.0.1
# 8788, one above prettycardboard's 8787, so the two can share a box.
Environment=AFM_PORT=8788
Environment=AFM_DATA_DIR=/opt/attackfm/data
# The library. Point this at a mounted volume when the box's own disk runs out -
# it is the only thing that has to move, and nothing else in the unit changes.
Environment=AFM_MUSIC_DIR=/opt/attackfm/music
Environment=AFM_SERVER_NAME=AttackFM
# A ceiling on the library in gigabytes, refused at upload rather than
# discovered when the disk fills and takes the database with it. 0 = no ceiling.
Environment=AFM_QUOTA_GB=25
# How often to re-walk the music folder. An unchanged library costs a directory
# walk and no tag reads, so this is cheap even on one core.
Environment=AFM_SCAN_MINUTES=15
# The public origin, for OAuth redirect URIs (the Spotify account link).
# Set it to your own domain; without it the Spotify connect endpoint explains.
# Environment=AFM_PUBLIC_URL=https://music.example.com
#
# This hub's Spotify app, so listeners connect with one button instead of
# pasting an id. Register <AFM_PUBLIC_URL>/api/spotify/callback as a redirect
# URI on it. NOT a secret - the PKCE flow puts the client id in the authorize
# URL in the open, and there is no client secret anywhere in this server - so
# it belongs in configuration rather than in each listener's settings.
# Environment=AFM_SPOTIFY_CLIENT_ID=your32charclientid
#
# The curator's local model, if this box runs one (Ollama, LM Studio, llama.cpp
# - anything with an OpenAI-compatible API). Two independent switches:
#
#   AFM_AI_URL + AFM_AI_EMBED_MODEL  read what songs are ABOUT, which is what
#                                    powers lyrical similarity. Cheap: ~0.65s
#                                    per track on one core with nomic-embed-text.
#   AFM_AI_MODEL                     writes playlist names and DJ patter. The
#                                    expensive half, and entirely optional -
#                                    leave it unset and the maths still runs,
#                                    with plain names.
#
# The ORIGIN only - the code appends /v1/embeddings and /v1/chat/completions.
# Environment=AFM_AI_URL=http://127.0.0.1:11434
# Environment=AFM_AI_EMBED_MODEL=nomic-embed-text
# Environment=AFM_AI_MODEL=qwen2.5:0.5b

WorkingDirectory=/opt/attackfm
ExecStart=/opt/attackfm/bin/attackfm-server
User=attackfm
Group=attackfm
Restart=on-failure
# The server catches SIGTERM and lets in-flight responses finish, but an audio
# body can be a whole album side - so cap the wait rather than letting a
# redeploy hang on one listener. Clients resume a cut stream by themselves.
TimeoutStopSec=10
RestartSec=2

# The server reads music and writes its own data; nothing else on the box is
# any of its business.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/attackfm/data /opt/attackfm/music
# Transcoding shells out to ffmpeg; without this the sandbox refuses the fork.
# Harmless when ffmpeg is not installed - the endpoint reports itself
# unavailable and nothing tries.
PrivateDevices=true

# One core and 1.6 GB of RAM is the box this was written for: keep the server
# from being the thing that OOMs it.
MemoryMax=512M

[Install]
WantedBy=multi-user.target
